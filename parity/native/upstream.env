# Reproducible default. A source checkout can be selected with UPSTREAM_SOURCE.
TAGLIB_VERSION=2.3.2
TAGLIB_SHA256=3ca2d8afaa7f1cf7f6ed10e511ebc368bfacd6dcaa3dbfa690b89e502e8963dc
TAGLIB_URL=https://taglib.org/releases/taglib-2.3.2.tar.gz
taglib_project_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../.." && pwd)
if [[ -n "${UPSTREAM_SOURCE:-}" ]]; then
  TAGLIB_SOURCE_DIR=$(cd -- "$UPSTREAM_SOURCE" && pwd)
  test -f "$TAGLIB_SOURCE_DIR/CMakeLists.txt"
  test -f "$TAGLIB_SOURCE_DIR/taglib/toolkit/taglib.h"
  TAGLIB_VERSION=$(awk '/^#define TAGLIB_MAJOR_VERSION / {major=$3} /^#define TAGLIB_MINOR_VERSION / {minor=$3} /^#define TAGLIB_PATCH_VERSION / {patch=$3} END {if(major=="" || minor=="" || patch=="") exit 1; print major "." minor "." patch}' "$TAGLIB_SOURCE_DIR/taglib/toolkit/taglib.h")

else
  TAGLIB_SOURCE_DIR="$taglib_project_root/work/upstream/verified/taglib-$TAGLIB_VERSION"
fi
export TAGLIB_VERSION TAGLIB_SHA256 TAGLIB_URL TAGLIB_SOURCE_DIR

verify_upstream_archive() {
  # Caller-selected sources are identified by their file hashes in the run report.
  if [[ -z "${UPSTREAM_SOURCE:-}" ]]; then
    printf '%s  %s\n' "$TAGLIB_SHA256" "$taglib_project_root/work/upstream/taglib-$TAGLIB_VERSION.tar.gz" | sha256sum --check --status
  fi
}
